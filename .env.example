# Local administration: password for /admin (editing on the site itself).
ADMIN_PASSWORD=defina-uma-senha-longa-e-unica
# To preview read-only demonstration locally:
DEMO_MODE=false

# Optional durable storage (Supabase). When both are set, content and photos are
# saved there instead of data/db.json and data/uploads, including on Vercel.
# The service role key is server-only: never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=catalog
